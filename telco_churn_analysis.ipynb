   "metadata": {},
   "source": [
    "# Telco Customer Churn - EDA & Prediction\n",
    "\n",
    "Dataset: [Telco Customer Churn](https://www.kaggle.com/datasets/blastchar/telco-customer-churn) (Kaggle, 7,043 customers, 21 columns).\n",
    "\n",
    "Goal: understand which factors are associated with customer churn, and build a baseline model to predict it."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "06821926",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import warnings\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.model_selection import train_test_split, StratifiedKFold, cross_val_score\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import classification_report, roc_auc_score, roc_curve, confusion_matrix\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "sns.set_theme(style=\"whitegrid\", font_scale=1.05)\n",
    "plt.rcParams[\"figure.figsize\"] = (10, 6)\n",
    "\n",
    "PALETTE = {\"No\": \"#2ecc71\", \"Yes\": \"#e74c3c\"}\n",
    "ACCENT = \"#3498db\"\n",
    "RANDOM_STATE = 42"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "464580dc",
   "metadata": {},
   "source": [
    "## 1. Load the data\n",
    "\n",
    "Uses `kagglehub` to pull the dataset directly. If that fails (no Kaggle credentials configured), it falls back to a local copy of the CSV in the working directory."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6376656b",
   "metadata": {},
   "outputs": [],
   "source": [
    "DATASET_HANDLE = \"blastchar/telco-customer-churn\"\n",
    "DATASET_FILE = \"WA_Fn-UseC_-Telco-Customer-Churn.csv\"\n",
    "\n",
    "try:\n",
    "    import kagglehub\n",
    "    from kagglehub import KaggleDatasetAdapter\n",
    "    df = kagglehub.load_dataset(KaggleDatasetAdapter.PANDAS, DATASET_HANDLE, DATASET_FILE)\n",
    "    print(f\"Loaded {df.shape[0]} rows from Kaggle.\")\n",
    "except Exception as e:\n",
    "    print(f\"kagglehub failed ({e}), loading local CSV instead.\")\n",
    "    df = pd.read_csv(DATASET_FILE)\n",
    "    print(f\"Loaded {df.shape[0]} rows from local CSV.\")\n",
    "\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6f86e323",
   "metadata": {},
   "source": [
    "## 2. Clean up\n",
    "\n",
    "`TotalCharges` is stored as text and has blank values for brand-new customers (`tenure == 0`, they haven't been billed yet). We coerce it to numeric and fill those with 0."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fac2c9a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "n_blank = (df[\"TotalCharges\"].astype(str).str.strip() == \"\").sum()\n",
    "df[\"TotalCharges\"] = pd.to_numeric(df[\"TotalCharges\"], errors=\"coerce\").fillna(0)\n",
    "df[\"SeniorCitizen\"] = df[\"SeniorCitizen\"].map({0: \"No\", 1: \"Yes\"})\n",
    "df[\"Churn_bin\"] = (df[\"Churn\"] == \"Yes\").astype(int)\n",
    "\n",
    "print(f\"{n_blank} blank TotalCharges values found and set to 0.\")\n",
    "df.isnull().sum().sum(), df.shape"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "617da243",
   "metadata": {},
   "source": [
    "## 3. Feature engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7d849be3",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"TenureGroup\"] = pd.cut(df[\"tenure\"], bins=[-1, 12, 24, 48, 72],\n",
    "                            labels=[\"0-12\", \"13-24\", \"25-48\", \"49-72\"])\n",
    "\n",
    "service_cols = [\"OnlineSecurity\", \"OnlineBackup\", \"DeviceProtection\",\n",
    "                 \"TechSupport\", \"StreamingTV\", \"StreamingMovies\"]\n",
    "df[\"NumServices\"] = (df[service_cols] == \"Yes\").sum(axis=1)\n",
    "\n",
    "df[\"ChargesPerTenure\"] = np.where(df[\"tenure\"] > 0,\n",
    "                                   df[\"TotalCharges\"] / df[\"tenure\"],\n",
    "                                   df[\"MonthlyCharges\"])\n",
    "df[[\"TenureGroup\", \"NumServices\", \"ChargesPerTenure\"]].head()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5e14ee93",
   "metadata": {},
   "source": [
    "## 4. Overview"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "70aed396",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\"Customers:            {len(df):,}\")\n",
    "print(f\"Churn rate:           {df['Churn_bin'].mean():.2%}\")\n",
    "print(f\"Avg tenure:           {df['tenure'].mean():.1f} months\")\n",
    "print(f\"Avg monthly charges:  ${df['MonthlyCharges'].mean():.2f}\")\n",
    "print(f\"Avg add-on services:  {df['NumServices'].mean():.1f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6ee942d0",
   "metadata": {},
   "source": [
    "## 5. Churn rate by contract, tenure, internet service and payment method"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7018ceed",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(2, 2, figsize=(15, 11))\n",
    "\n",
    "specs = [\n",
    "    (\"Contract\", [\"Month-to-month\", \"One year\", \"Two year\"], axes[0, 0], \"Contract Type\"),\n",
    "    (\"TenureGroup\", [\"0-12\", \"13-24\", \"25-48\", \"49-72\"], axes[0, 1], \"Tenure Group\"),\n",
    "    (\"InternetService\", [\"DSL\", \"Fiber optic\", \"No\"], axes[1, 0], \"Internet Service\"),\n",
    "    (\"PaymentMethod\", None, axes[1, 1], \"Payment Method\"),\n",
    "]\n",
    "\n",
    "for col, order, ax, title in specs:\n",
    "    if order is None:\n",
    "        order = df.groupby(col)[\"Churn_bin\"].mean().sort_values(ascending=False).index\n",
    "    sns.barplot(data=df, x=col, y=\"Churn_bin\", order=order, errorbar=None, color=ACCENT, ax=ax)\n",
    "    ax.set_title(f\"Churn Rate by {title}\", fontsize=13)\n",
    "    ax.set_xlabel(\"\")\n",
    "    ax.set_ylabel(\"Churn Rate\")\n",
    "    ax.tick_params(axis=\"x\", rotation=20 if col == \"PaymentMethod\" else 0)\n",
    "    for p in ax.patches:\n",
    "        h = p.get_height()\n",
    "        if not np.isnan(h):\n",
    "            ax.annotate(f\"{h:.1%}\", (p.get_x() + p.get_width() / 2, h),\n",
    "                        ha=\"center\", va=\"bottom\", fontsize=11, fontweight=\"bold\")\n",
    "\n",
    "fig.suptitle(\"Churn Rate Overview\", fontsize=17, y=1.02)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3249b6f3",
   "metadata": {},
   "source": [
    "## 6. Tenure distribution and monthly charges"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d585c432",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(10, 6))\n",
    "sns.histplot(data=df, x=\"tenure\", hue=\"Churn\", multiple=\"stack\", palette=PALETTE, bins=30, edgecolor=\"white\")\n",
    "plt.title(\"Tenure Distribution by Churn\")\n",
    "plt.xlabel(\"Tenure (months)\")\n",
    "plt.ylabel(\"Customers\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ce6cdba3",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(8, 6))\n",
    "sns.boxplot(data=df, x=\"Churn\", y=\"MonthlyCharges\", palette=PALETTE)\n",
    "plt.title(\"Monthly Charges by Churn\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d9dc5585",
   "metadata": {},
   "source": [
    "## 7. Correlation between numeric features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7231d472",
   "metadata": {},
   "outputs": [],
   "source": [
    "num_cols = [\"tenure\", \"MonthlyCharges\", \"TotalCharges\", \"NumServices\", \"ChargesPerTenure\", \"Churn_bin\"]\n",
    "plt.figure(figsize=(8, 6.5))\n",
    "sns.heatmap(df[num_cols].corr(), annot=True, fmt=\".2f\", cmap=\"RdBu_r\", center=0,\n",
    "            vmin=-1, vmax=1, square=True, linewidths=0.5)\n",
