   ]
  },
  {
   "cell_type": "markdown",
   "id": "c66226fc",
   "metadata": {},
   "source": [
    "## 8. Do add-on services reduce churn?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7a4c8167",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(9, 6))\n",
    "ax = sns.barplot(data=df, x=\"NumServices\", y=\"Churn_bin\", errorbar=None, color=\"#9b59b6\")\n",
    "plt.title(\"Churn Rate by Number of Add-on Services\")\n",
